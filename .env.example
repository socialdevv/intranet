NODE_ENV=development
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intranet
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_MAX=200
RATE_LIMIT_TIME_WINDOW=1 minute
UPLOAD_MAX_FILE_SIZE_BYTES=314572800
UPLOAD_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_TIME_WINDOW=1 minute
ENABLE_SWAGGER=false
# Temporary header-based auth for pre-IdP Docker testing (never enable in live production).
ENABLE_PREVIEW_AUTH=false
# Optional server-side default when preview auth is on and x-dev-user-email is absent.
PREVIEW_AUTH_DEFAULT_USER_EMAIL=
# Docker only: auto (seed when empty), true (always seed), false (never seed)
RUN_DB_SEED=auto
STATIC_WEB_ROOT=
VITE_ALTCLOUD_API_BASE_URL=http://127.0.0.1:3001
VITE_ALTCLOUD_API_DEV_USER_EMAIL=
